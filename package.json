{
  "name": "sound-trail",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --config apps/desktop/vite.config.ts --host 127.0.0.1",
    "build": "tsc --noEmit && vite build --config apps/desktop/vite.config.ts && node scripts/write-offline.mjs",
    "preview": "vite preview --config apps/desktop/vite.config.ts --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit",
    "test:browser": "node scripts/browser-check.mjs",
    "test:airspace": "node scripts/airspace-check.mjs",
    "test:workshop": "node scripts/workshop-check.mjs",
    "test:observation": "node scripts/observation-check.mjs",
    "test:evolution": "node scripts/evolution-check.mjs",
    "test:offline": "node scripts/offline-check.mjs",
    "test:vr": "node scripts/vr-check.mjs",
    "test:audio": "node scripts/audio-output-check.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "iwer": "^2.4.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
